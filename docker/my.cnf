[mysqld]
# ===== Réglages InnoDB pour GestImmo =====
default_storage_engine         = InnoDB
character-set-server           = utf8mb4
collation-server               = utf8mb4_unicode_ci
innodb_buffer_pool_size        = 512M   # ~ 50-70 % de la RAM d'un serveur dédié
innodb_log_file_size           = 128M
innodb_flush_log_at_trx_commit = 1
innodb_flush_method            = O_DIRECT
innodb_file_per_table          = 1
innodb_ft_min_token_size       = 3      # recherche FULLTEXT sur des mots de 3 lettres
max_connections                = 200
slow_query_log                 = 1
long_query_time                = 0.5
